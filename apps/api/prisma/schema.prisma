// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RoomVibe {
  DEEP_TALK
  CHAOS
  RANT_ZONE
  GAMER_LOBBY
}

enum RoomKind {
  GROUP
  MATCHED
}

enum RoomStatus {
  ACTIVE
  EXPIRED
}

enum ReactionType {
  FIRE
  LAUGH
  SHOCK
  MIND_BLOWN
  LIKE
  LOVE
  SAD
  ANGRY
}

enum PollOption {
  A
  B
}

enum RoomMemberRole {
  OWNER
  MEMBER
}

enum RoomMembershipStatus {
  ACTIVE
  LEFT
}

model AnonymousUser {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  identityCredential IdentityCredential?
  createdRooms       Room[]              @relation("RoomCreator")
  memberships        RoomMembership[]
  ageEligibility     AgeEligibility?
  matchSearch        MatchSearch?
  matchesA           MatchSession[] @relation("MatchA")
  matchesB           MatchSession[] @relation("MatchB")
  blocksCreated      MatchBlock[] @relation("Blocker")
  blocksReceived     MatchBlock[] @relation("Blocked")

  @@map("anonymous_users")
}

enum AgeEligibilityResult {
  ELIGIBLE
  INELIGIBLE
}

enum AgeAssessmentMethod {
  DECLARED_DOB
}

model AgeEligibility {
  userId        String                 @id @db.Uuid
  result        AgeEligibilityResult
  method        AgeAssessmentMethod    @default(DECLARED_DOB)
  assessedAt    DateTime               @default(now()) @db.Timestamptz(6)
  policyVersion String                 @db.VarChar(80)
  user          AnonymousUser          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("age_eligibility")
}

model IdentityCredential {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @unique @db.Uuid
  tokenHash String    @unique @db.VarChar(128)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt DateTime? @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)

  user AnonymousUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("identity_credentials")
}

model Room {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String     @unique @db.VarChar(7)
  kind        RoomKind   @default(GROUP)
  inviteId    String?    @unique @db.Uuid
  vibe        RoomVibe
  name        String?    @db.VarChar(100)
  creatorId   String     @db.Uuid
  status      RoomStatus @default(ACTIVE)
  lockedUntil DateTime?  @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  expiresAt   DateTime   @db.Timestamptz(6)

  matchSession MatchSession?
  creator     AnonymousUser    @relation("RoomCreator", fields: [creatorId], references: [id])
  memberships RoomMembership[]
  participantReports ParticipantReport[]
  messages    Message[]
  polls       Poll[]

  @@index([expiresAt, id])
  @@index([status, expiresAt])
  @@index([creatorId])
  @@map("rooms")
}

model RoomMembership {
  publicId    String               @unique @default(dbgenerated("('p_'::text || replace((gen_random_uuid())::text, '-'::text, ''::text))")) @db.VarChar(34)
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId      String               @db.Uuid
  userId      String               @db.Uuid
  ghostName   String               @db.VarChar(50)
  ghostAvatar String               @db.VarChar(100)
  role        RoomMemberRole       @default(MEMBER)
  status      RoomMembershipStatus @default(ACTIVE)
  leftAt      DateTime?            @db.Timestamptz(6)
  joinedAt    DateTime             @default(now()) @db.Timestamptz(6)

  room      Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      AnonymousUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  reports   MessageReport[]
  participantReportsMade ParticipantReport[] @relation("ParticipantReporter")
  participantReportsReceived ParticipantReport[] @relation("ParticipantTarget")
  reactions Reaction[]
  pollVotes PollVote[]

  @@unique([userId, roomId])
  @@index([userId])
  @@index([roomId])
  @@map("room_memberships")
}

model Message {
  publicId        String   @unique @default(dbgenerated("('m_'::text || replace((gen_random_uuid())::text, '-'::text, ''::text))")) @db.VarChar(34)
  clientMessageId String?  @db.VarChar(36)
  replyToId       String?  @db.Uuid
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId          String   @db.Uuid
  membershipId    String   @db.Uuid
  text            String   @db.VarChar(2000)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  room       Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  membership RoomMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  reactions  Reaction[]
  reports    MessageReport[]
  replyTo    Message? @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    Message[] @relation("MessageReply")

  @@unique([membershipId, clientMessageId])
  @@index([roomId, createdAt, publicId])
  @@index([roomId, createdAt])
  @@index([membershipId])
  @@map("messages")
}

model MessageReport {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId            String   @db.Uuid
  reporterMembershipId String   @db.Uuid
  reason               String   @db.VarChar(32)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)

  message  Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter RoomMembership @relation(fields: [reporterMembershipId], references: [id], onDelete: Cascade)

  @@unique([messageId, reporterMembershipId])
  @@index([reporterMembershipId])
  @@map("message_reports")
}

model ParticipantReport {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId String @db.Uuid
  reporterMembershipId String @db.Uuid
  targetMembershipId String @db.Uuid
  reason String @db.VarChar(32)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reporter RoomMembership @relation("ParticipantReporter", fields: [reporterMembershipId], references: [id], onDelete: Cascade)
  target RoomMembership @relation("ParticipantTarget", fields: [targetMembershipId], references: [id], onDelete: Cascade)

  @@unique([roomId, reporterMembershipId, targetMembershipId])
  @@index([createdAt])
  @@map("participant_reports")
}

model Reaction {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId    String       @db.Uuid
  membershipId String       @db.Uuid
  type         ReactionType
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)

  message    Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  membership RoomMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([messageId, membershipId])
  @@index([messageId])
  @@index([membershipId])
  @@map("reactions")
}

model Poll {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId    String   @db.Uuid
  question  String   @db.VarChar(500)
  optionA   String   @db.VarChar(100)
  optionB   String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  votes PollVote[]

  @@index([roomId, expiresAt])
  @@map("polls")
}

model PollVote {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pollId       String     @db.Uuid
  membershipId String     @db.Uuid
  option       PollOption
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  poll       Poll           @relation(fields: [pollId], references: [id], onDelete: Cascade)
  membership RoomMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([pollId, membershipId])
  @@index([pollId])
  @@index([membershipId])
  @@map("poll_votes")
}

model MatchSearch {
  userId    String @id @db.Uuid
  publicId  String @unique @default(dbgenerated("('s_'::text || replace((gen_random_uuid())::text, '-'::text, ''::text))")) @db.VarChar(34)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  leaseUntil DateTime @db.Timestamptz(6)
  user AnonymousUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@index([leaseUntil])
  @@map("match_searches")
}

model MatchSession {
  roomId String @id @db.Uuid
  publicId String @unique @default(dbgenerated("('c_'::text || replace((gen_random_uuid())::text, '-'::text, ''::text))")) @db.VarChar(34)
  userAId String @db.Uuid
  userBId String @db.Uuid
  extended Boolean @default(false)
  voteA Boolean @default(false)
  voteB Boolean @default(false)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userA AnonymousUser @relation("MatchA", fields: [userAId], references: [id], onDelete: Cascade)
  userB AnonymousUser @relation("MatchB", fields: [userBId], references: [id], onDelete: Cascade)
  @@index([userAId])
  @@index([userBId])
  @@map("match_sessions")
}

model MatchBlock {
  blockerId String @db.Uuid
  blockedId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  blocker AnonymousUser @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked AnonymousUser @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("match_blocks")
}
