#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/suraj/projects/ghosttag/node_modules/.pnpm/browserslist@4.28.8/node_modules/browserslist/node_modules:/home/suraj/projects/ghosttag/node_modules/.pnpm/browserslist@4.28.8/node_modules:/home/suraj/projects/ghosttag/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/suraj/projects/ghosttag/node_modules/.pnpm/browserslist@4.28.8/node_modules/browserslist/node_modules:/home/suraj/projects/ghosttag/node_modules/.pnpm/browserslist@4.28.8/node_modules:/home/suraj/projects/ghosttag/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../browserslist/cli.js" "$@"
else
  exec node  "$basedir/../../../../browserslist/cli.js" "$@"
fi
