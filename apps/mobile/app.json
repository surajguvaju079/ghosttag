{
  "expo": {
    "name": "GhostTag",
    "slug": "ghosttag",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "ghosttag",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/brand/app-icon.png",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "GhostTag connects to your development API on the local network during local testing."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0B1F",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0B1F",
          "image": "./assets/brand/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
