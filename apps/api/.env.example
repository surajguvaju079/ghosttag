# Local Docker Compose development only. Never use these credentials in deployment.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://ghosttag:ghosttag_dev@localhost:5432/ghosttag

# Disabled by default. Enable only for local development/authorized testing.
SOCIAL_ACCESS_ENABLED=false
AGE_POLICY_VERSION=18-plus-v1

# New searches are disabled by default. Existing end/block controls remain usable.
MATCHING_ENABLED=false
