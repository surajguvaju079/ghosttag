# Full HTTP API base, including /api/v1. No credentials in EXPO_PUBLIC variables.
# Android emulator: http://10.0.2.2:8080/api/v1
# iOS simulator: http://127.0.0.1:8080/api/v1
# Physical device: http://<your-computer-LAN-IP>:8080/api/v1 (same network)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1
# Optional Socket.IO origin, default derived from API URL origin. No /rooms suffix.
# EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:8080

# Production EAS profile sets EXPO_PUBLIC_APP_ENV=production. Configure actual
# public HTTPS API /api/v1 and Socket.IO HTTPS origin in EAS production variables.
# Production rejects missing URLs, HTTP, all IP literals, and local/reserved hosts.
# Do not copy the development URL above into the production environment.
# Owner-approved published policy URLs, never credentials:
# EXPO_PUBLIC_PRIVACY_URL=
# EXPO_PUBLIC_CHILD_SAFETY_URL=
# EXPO_PUBLIC_TERMS_URL=
# EXPO_PUBLIC_COMMUNITY_URL=
