# Full HTTP API base, including /api/v1. No credentials in EXPO_PUBLIC variables.
# Android emulator: http://10.0.2.2:8080/api/v1
# iOS simulator: http://127.0.0.1:8080/api/v1
# Physical device: http://<your-computer-LAN-IP>:8080/api/v1 (same network)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1
# Optional Socket.IO origin, default derived from API URL origin. No /rooms suffix.
# EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:8080
